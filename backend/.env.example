APP_ENV=development
DATABASE_PATH=./marketmind.db
FRONTEND_ORIGIN=http://localhost:5173

# Gemini (fallback/primary reasoning when no role-specific Lyzr agent is mapped)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alpha Vantage: fallback quote provider if Yahoo chart is unavailable
ALPHA_VANTAGE_API_KEY=

# Lyzr Inference v3. Create/deploy the agent(s) in Lyzr Studio and copy their IDs.
LYZR_API_KEY=
LYZR_AGENT_ENDPOINT=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
LYZR_AGENT_ID=
LYZR_AGENT_IDS={}
LYZR_USER_ID=marketmind-demo
LYZR_SESSION_ID=marketmind

# BAND Agent API. Use either one sender identity or distinct sender identities.
# BAND_CHAT_ID is the shared room ID. BAND_AGENT_API_KEY is one Agent API key;
# alternatively BAND_AGENT_KEYS is JSON {role: api_key} for the six roles.
# All six recipient entries are required in BAND_AGENT_PEERS JSON, with actual
# participant IDs, names, and handles from that room. Never paste real keys here.
BAND_AGENT_API_KEY=
BAND_CHAT_ID=
BAND_AGENT_KEYS={}
BAND_AGENT_PEERS={}
BAND_VALIDATE_ROLE=analyst

# Finch local packs are not Remote MCP. No FINCH_API_KEY is used by this project.
FINCH_SKILLS_DIR=.finch/skills
# Optional display/config value only; this backend does not invoke remote MCP tools.
FINCH_MCP_URL=https://www.finchtech.ai/mcp

# AdaL Inbound Server public ingest URL; the app POSTs completed reports to it.
ADAL_WEBHOOK_URL=
# Generate your own random shared secret and configure the same header/value
# on the AdaL Endpoint that forwards inbound events to MarketMind.
ADAL_WEBHOOK_TOKEN=
ADAL_WEBHOOK_HEADER=X-MarketMind-Webhook-Token

# Agent 37 workspace key (Bearer auth for provisioning; provisioning may cost money).
AGENT37_API_KEY=
AGENT37_TEMPLATE=agent37-hermes
# Set these only after you have provisioned/configured an instance yourself.
AGENT37_INSTANCE_ID=
AGENT37_INSTANCE_URL=
# Instance gateway key: the API_SERVER_KEY configured inside Hermes, not workspace key.
AGENT37_INSTANCE_API_KEY=
AGENT37_MODEL=hermes
AGENT37_USE_FOR_CHAIR=false
