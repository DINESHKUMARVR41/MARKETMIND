APP_ENV=development
DATABASE_PATH=./marketmind.db
FRONTEND_ORIGIN=http://localhost:5173

# Gemini: real LLM reasoning for Analyst, News, Bull, Bear, Risk and fallback Chair
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alpha Vantage: fallback quote provider if Yahoo chart is unavailable
ALPHA_VANTAGE_API_KEY=

# Lyzr: optional live Portfolio Chair inference (Gemini is fallback)
LYZR_API_KEY=
LYZR_AGENT_ID=
# Optional JSON map for six separate Lyzr role agents; when a role is absent it falls back to Gemini.
LYZR_AGENT_IDS={}
LYZR_AGENT_ENDPOINT=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
LYZR_USER_ID=marketmind-demo
LYZR_SESSION_ID=marketmind-chair

# BAND: register six agent identities, add them to one shared room, then map credentials.
BAND_CHAT_ID=
BAND_AGENT_KEYS={}
BAND_AGENT_PEERS={}

# AdaL: webhook URL and optional bearer token from your configured AdaL workflow
ADAL_WEBHOOK_URL=
ADAL_WEBHOOK_TOKEN=

# Agent37: set after deployment in your Agent37 workspace
AGENT37_PUBLIC_URL=
